# ============================================================
# GuDuu OS 网站安全响应头（由两种 Caddy 部署模式共同引用）
# ------------------------------------------------------------
# 这里刻意保留 Matrix 媒体、WebSocket、Web Worker、WASM 加密模块、
# Cloudflare Turnstile 以及现有字体 CDN 所需的来源；收紧策略时必须先做
# 登录、加密聊天、附件、音视频和人机验证的完整回归，不能只看首页能否打开。
# ============================================================

header {
	# 默认只信任本站；脚本仅额外允许登录页使用的 Turnstile。Matrix 加密 SDK
	# 需要 wasm-unsafe-eval 来编译本地 WASM，但这不会允许普通字符串 eval。
	Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src 'self' https:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

	# 禁止浏览器 MIME 猜测，避免把用户上传或错误返回的内容当脚本执行。
	X-Content-Type-Options "nosniff"
	# 页面不允许被第三方 iframe 套壳，和 CSP 的 frame-ancestors 双保险。
	X-Frame-Options "DENY"
	# 跨站跳转只发送来源站点，不把房间地址、参数等完整路径泄给外站。
	Referrer-Policy "strict-origin-when-cross-origin"
	# 明确拒绝旧版 Flash/Adobe 客户端加载站内数据。
	X-Permitted-Cross-Domain-Policies "none"
}

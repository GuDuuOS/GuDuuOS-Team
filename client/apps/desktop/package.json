{
  "name": "guduu-os-desktop",
  "productName": "GuDuu OS",
  "private": true,
  "version": "1.26.1",
  "description": "GuDuu OS desktop client for macOS and Windows",
  "author": "GuDuu OS",
  "license": "UNLICENSED",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "cross-env GUDUU_DESKTOP_DEV_URL=http://127.0.0.1:5173 concurrently --kill-others-on-fail \"npm --prefix ../.. run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "check": "node scripts/verify-store-config.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:safe-storage": "electron tests/real-safe-storage-smoke.mjs",
    "sync:renderer": "node scripts/sync-renderer.mjs",
    "build:renderer": "npm --prefix ../.. run build && npm run sync:renderer",
    "package:mac": "npm run build:renderer && electron-forge package --platform=darwin",
    "package:mas": "npm run build:renderer && cross-env GUDUU_DESKTOP_TARGET=mas electron-forge package --platform=mas",
    "package:windows": "npm run build:renderer && electron-forge package --platform=win32 --arch=x64",
    "make:mac": "npm run build:renderer && electron-forge make --platform=darwin",
    "make:windows": "npm run build:renderer && electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-msix": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron/fuses": "2.1.3",
    "concurrently": "9.2.4",
    "cross-env": "10.0.0",
    "electron": "43.2.0",
    "electron-winstaller": "5.4.4",
    "plist": "3.1.0",
    "wait-on": "8.0.4"
  }
}

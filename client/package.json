{
  "name": "cosmac-workbench",
  "private": true,
  "version": "1.24.2",
  "type": "module",
  "description": "GuDuu OS · AI 工作台",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "type-check": "vue-tsc --noEmit",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:check": "npm --prefix apps/desktop run check",
    "desktop:package:mac": "npm --prefix apps/desktop run package:mac",
    "desktop:package:mas": "npm --prefix apps/desktop run package:mas",
    "desktop:package:windows": "npm --prefix apps/desktop run package:windows"
  },
  "dependencies": {
    "chart.js": "^4.4.6",
    "lucide-vue-next": "^0.577.0",
    "matrix-js-sdk": "^41.8.0-rc.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  }
}

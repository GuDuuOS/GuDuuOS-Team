[Unit]
Description=Mirror immutable GuDuu images from GHCR to the private registry
After=network-online.target docker.service postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/cosmac
EnvironmentFile=/etc/nexus.env
Environment=PYTHONPATH=/opt/cosmac
ExecStart=/opt/nexus/venv/bin/python /opt/cosmac/scripts/mirror_release_images.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/guduu-registry /root/.cache
